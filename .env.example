# Copy to .env.local for local dev with `vercel dev`. NEVER commit real values.
# In production, set these in the Vercel dashboard (Project -> Settings -> Environment Variables).

# --- Public (safe in the browser) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Server-only secrets (no VITE_ prefix!) ---
CLERK_SECRET_KEY=sk_test_...
TURSO_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=...
GROQ_API_KEY=gsk_...

# --- Optional ---
# GROQ_MODEL=openai/gpt-oss-120b
# CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app
# CHAT_PER_MINUTE=12
# CHAT_PER_DAY=150
# CHAT_GLOBAL_PER_DAY=3000
